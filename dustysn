import dustysn.model as dm 

### FIT EPOCH 1######
print( "Fit Epoch 1")
obs_wave_1, obs_flux_1, obs_flux_err_1, limits_1, filters_1, w_filt_1, t_filt_1 = dm.import_data('epoch1_2017eaw.txt') #only really need to parse wavelength, flux, error, and FILTER with dustysn data loader

#passing obs into MCMC fitting formmat 
results_ep1, samples_ep1 = dm.fit_dust_model(
    obs_wave=obs_wave_1,
    obs_flux=obs_flux_1,
    obs_flux_err=obs_flux_err_1,
    obs_limits=limits_1, 
    redshift=0.00013, #redshift for SN2017eaw NGC 6946
    object_name='SN2017eaw_Epoch1',
    composition='silicate', #plotting the silicate-dominated late dust emission 
    n_components=1, #fitting one temperature dust shell?, can expand to 2 to capture mIR 
    n_walkers=20, #walkers used in pearson, copycat
    n_steps=3000, #2000 to converge + 1000 to sample posterior 
    burn_in=2000/3000, #fraction for above steps 
    obs_wave_filters=w_filt_1,
    obs_trans_filters=t_filt_1,
    plot=True
) 

                                                                                               
